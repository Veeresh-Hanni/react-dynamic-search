{
  "name": "react-dynamic-search",
  "version": "0.2.1",
  "description": "A debounced, filterable, cache-aware search hook for React.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "keywords": [
    "react",
    "hooks",
    "search",
    "debounce",
    "react-query"
  ],
  "peerDependencies": {
    "@tanstack/react-query": ">=4.0.0",
    "jsdom": "^24.0.0",
    "react": ">=16.8.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@testing-library/react": "^15.0.0",
    "@types/react": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts,.tsx",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veeresh-hanni/react-dynamic-search.git"
  }
}
